# Copy to .env.production beside this file, fill it in, and keep it at mode
# 0600. It is gitignored. Back up SESAME_ADMIN_ENCRYPTION_KEY somewhere you
# will still have it after a disk failure: losing it makes every
# administrator's MFA secret unreadable and locks them all out.
#
# Generate each secret separately:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='

SESAME_DATABASE_PASSWORD=
SESAME_CAPABILITY_SIGNING_KEY=
SESAME_ADMIN_ENCRYPTION_KEY=
SESAME_ADMIN_IP_PEPPER=

# The Ed25519 public half of SESAME_CAPABILITY_SIGNING_KEY. `npm run setup`
# derives it; copy the value it writes rather than generating a new pair.
SESAME_CAPABILITY_PUBLIC_KEY=

# Origins. Each must be an exact scheme and host with no trailing slash.
SESAME_PUBLIC_SITE_ORIGIN=https://usesesame.app
SESAME_ACCOUNT_ORIGIN=https://account.usesesame.app
SESAME_ADMIN_ORIGIN=https://admin.usesesame.app
SESAME_API_ORIGIN=https://api.usesesame.app

# The registrable domain the account portal is served from. A passkey created
# under the wrong value cannot be used, and changing it later invalidates every
# passkey already registered.
SESAME_RP_ID=account.usesesame.app
SESAME_RP_NAME=Sesame

# The immutable version string of this deployment, shown in API responses.
SESAME_API_VERSION=0.1.0

# closed, invite, or public. With the administration portal running, the
# database feature flag wins and this is only the fallback.
SESAME_REGISTRATION_MODE=invite

# CIDR ranges the API will accept a forwarded client address from. For a proxy
# on the same host this is the Docker bridge network. Verify it with
# `docker network inspect sesame-prod_default`; do not widen it to 0.0.0.0/0,
# which lets any client forge its own address and defeat rate limiting.
SESAME_TRUSTED_PROXIES=172.16.0.0/12

# STARTTLS is mandatory. Verification, recovery, and email-change delivery all
# stop working without it.
SESAME_SMTP_ADDR=smtp.example.com:587
SESAME_SMTP_USERNAME=
SESAME_SMTP_PASSWORD=
SESAME_SMTP_FROM=Sesame <accounts@usesesame.app>

# Build contexts, relative to this directory. `npm run setup` fills these in.
SESAME_SERVER_CONTEXT=../..
SESAME_ACCOUNT_CONTEXT=../../web/account
SESAME_ADMIN_CONTEXT=../../web/admin
