DATABASE_URL=postgres://sesame:local-development-only@127.0.0.1:5432/sesame?sslmode=disable
SESAME_API_ADDR=127.0.0.1:8787
SESAME_API_VERSION=0.1.0-dev
SESAME_WEB_ORIGIN=http://localhost:4173
SESAME_CAPABILITY_SIGNING_KEY=
SESAME_CAPABILITY_KEY_ID=capability-v1
SESAME_MINIMUM_DESKTOP_VERSION=0.1.0
SESAME_LATEST_DESKTOP_VERSION=0.1.0
# Optional but required before the release pipeline can submit candidates.
# This is the base64url Ed25519 public key corresponding to the CI-only
# candidate signing seed, not the Tauri updater public key.
SESAME_RELEASE_CANDIDATE_PUBLIC_KEY=
SESAME_RELEASE_CANDIDATE_KEY_ID=
# CI-only bearer secret, base64url-encoded 32 random bytes. It authorizes
# POST /v1/release-candidates and is independent of browser admins.
SESAME_RELEASE_CANDIDATE_TOKEN=
SESAME_DESKTOP_UPDATE_BASE_URL=
SESAME_ARTIFACT_GATEWAY_URL=
# Base64url 32-byte HMAC key shared only with the private artifact gateway.
SESAME_ARTIFACT_GATEWAY_SIGNING_KEY=
SESAME_SESSION_SECURE=false
SESAME_REGISTRATION_MODE=invite

# Separate admin origin and secrets. Generate both secrets locally; never
# commit or reuse them. The admin API stays disabled while the encryption key
# is empty.
SESAME_ADMIN_ORIGIN=http://localhost:4174
SESAME_ADMIN_SESSION_SECURE=false
# Leave empty for a host-only admin cookie (recommended).
SESAME_ADMIN_SESSION_DOMAIN=
# Generate with: openssl rand -hex 32
SESAME_ADMIN_ENCRYPTION_KEY=
# Generate independently with: openssl rand -hex 32
SESAME_ADMIN_IP_PEPPER=

# Required for verification, recovery, and email-change delivery.
# The SMTP server must support STARTTLS.
# SESAME_SMTP_ADDR=smtp.example.com:587
# SESAME_SMTP_USERNAME=
# SESAME_SMTP_PASSWORD=
# SESAME_SMTP_FROM=Sesame <accounts@your-domain.example>
# SESAME_ENV=development
# SESAME_SMTP_ALLOW_INSECURE_LOCAL=true # local Mailpit capture only; never production

# Website passkeys.
# SESAME_RP_ID=localhost
# SESAME_RP_NAME=Sesame
