# Development-only example. Copy to account/.env.local to connect the portal
# to the local Compose API. The portal is served from its own origin, which is
# also the origin the server puts in its account emails (SESAME_WEB_ORIGIN).
VITE_SESAME_API_URL=http://localhost:8787
VITE_SESAME_SITE_ORIGIN=http://localhost:4173
VITE_SESAME_CAPABILITY_PUBLIC_KEY=
