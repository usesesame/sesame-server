{
    "name": "@sesame/account",
    "private": true,
    "license": "AGPL-3.0-or-later",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.config.ts",
        "build": "vite build --config vite.config.ts && node scripts/build-security-headers.mjs && node scripts/headers-to-nginx.mjs",
        "preview": "vite preview --config vite.config.ts",
        "lint": "eslint .",
        "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
        "design:tokens:check": "node scripts/design-tokens-contract.mjs",
        "test": "node scripts/skip-with-message.mjs \"account portal browser\" \"npm run build\"",
        "release:check": "npm run design:tokens:check && npm run lint && npm run check && npm run build",
        "ci": "npm run design:tokens:check && npm run lint && npm run check"
    },
    "dependencies": {
        "svelte": "^5.57.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^26.4.1",
        "eslint": "^10.9.1",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "svelte-check": "^4.7.6",
        "svelte-eslint-parser": "^1.8.1",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2"
    }
}
