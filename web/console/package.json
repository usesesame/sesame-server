{
    "name": "@sesame/console",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.config.ts",
        "build": "vite build --config vite.config.ts && node scripts/check-dist.mjs",
        "preview": "vite preview --config vite.config.ts",
        "lint": "eslint .",
        "check": "svelte-check --tsconfig ./tsconfig.json && node ./node_modules/@typescript/native/bin/tsc --noEmit",
        "design:tokens:check": "node scripts/design-tokens-contract.mjs",
        "test": "vitest run",
        "shots": "node tools/screenshots.mjs",
        "release:check": "npm run design:tokens:check && npm run lint && npm run check && npm run test && npm run build",
        "ci": "npm run design:tokens:check && npm run lint && npm run check && npm run test"
    },
    "dependencies": {
        "svelte": "^5.57.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.8",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^26.6.5",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.14.0",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "svelte-check": "^4.7.7",
        "svelte-eslint-parser": "^1.10.0",
        "typescript": "npm:@typescript/typescript6@~6.0.2",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
