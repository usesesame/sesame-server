# Review routing for the Sesame server. Later rules win, so the paths where a
# mistake is silent are listed last.

* @d0mkaaa

# Delivery controls. Changing these changes what "passing" means.
/.github/                @d0mkaaa
/.golangci.yml           @d0mkaaa
/package.json            @d0mkaaa
/package-lock.json       @d0mkaaa
/scripts/                @d0mkaaa
# A lockfile change is a supply-chain change.
/go.sum                  @d0mkaaa

# Authentication, sessions, tokens, origin rules, and the admin control plane.
/internal/accounts/      @d0mkaaa
/internal/admin/         @d0mkaaa
/internal/httpapi/       @d0mkaaa

# Sync stays built-disabled until its own review passes. Nothing here should
# change without that review moving first.
/internal/syncproto/     @d0mkaaa
/internal/syncstore/     @d0mkaaa

# Migrations are immutable after release, and the generated contract is what
# every client is written against.
/internal/accounts/migrations/ @d0mkaaa
/openapi/                @d0mkaaa
/API.md                  @d0mkaaa

# The deployment a self-hoster runs, including the keys it generates.
/deploy/                 @d0mkaaa
/scripts/setup.mjs       @d0mkaaa
/Dockerfile              @d0mkaaa

# The account portal is the only origin the server accepts a credentialed
# request from, and the only Sesame web surface that holds a session. These
# decide who is signed in, what proves it, and what a recovery link can do.
/web/account/src/lib/auth.ts                    @d0mkaaa
/web/account/src/lib/api.ts                     @d0mkaaa
/web/account/src/lib/passkey.ts                 @d0mkaaa
/web/account/src/lib/capabilities.ts            @d0mkaaa
/web/account/src/lib/runtime-config.ts          @d0mkaaa
/web/account/src/pages/AccountFlowPage.svelte   @d0mkaaa
/web/account/scripts/build-security-headers.mjs @d0mkaaa
/web/account/public/_headers                    @d0mkaaa

# The administration portal reaches the privileged control plane on its own
# origin, with its own session and CSRF token. These decide what it can reach
# and what a page it renders is allowed to do.
/web/admin/src/lib/api.ts                       @d0mkaaa
/web/admin/src/lib/runtime-config.ts            @d0mkaaa
/web/admin/scripts/build-security-headers.mjs   @d0mkaaa
/web/admin/public/_headers                      @d0mkaaa

# Delivery controls for both portals.
/web/account/package.json      @d0mkaaa
/web/account/package-lock.json @d0mkaaa
/web/account/eslint.config.js  @d0mkaaa
